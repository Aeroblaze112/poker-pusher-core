[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/rules_page.gd" id="1_rules"]

[node name="RulesPage" type="PanelContainer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_type_variation = &"ScrimDark"
script = ExtResource("1_rules")

[node name="Center" type="CenterContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Card" type="PanelContainer" parent="Center"]
theme_type_variation = &"Card"

[node name="Margin" type="MarginContainer" parent="Center/Card"]
theme_override_constants/margin_left = 28
theme_override_constants/margin_top = 16
theme_override_constants/margin_right = 28
theme_override_constants/margin_bottom = 16

[node name="VBox" type="VBoxContainer" parent="Center/Card/Margin"]
theme_override_constants/separation = 8

[node name="Title" type="Label" parent="Center/Card/Margin/VBox"]
theme_override_colors/font_color = Color(0.85, 0.7, 0.32, 1)
theme_override_colors/font_shadow_color = Color(0, 0, 0, 0.6)
theme_override_constants/shadow_offset_x = 2
theme_override_constants/shadow_offset_y = 2
theme_override_font_sizes/font_size = 27
text = "玩法说明"
horizontal_alignment = 1

[node name="Subtitle" type="Label" parent="Center/Card/Margin/VBox"]
theme_override_colors/font_color = Color(0.7, 0.72, 0.66, 1)
theme_override_font_sizes/font_size = 13
text = "四回合，把构筑组做到最大"
horizontal_alignment = 1

[node name="Cols" type="HBoxContainer" parent="Center/Card/Margin/VBox"]
theme_override_constants/separation = 22

[node name="ColLeft" type="VBoxContainer" parent="Center/Card/Margin/VBox/Cols"]
custom_minimum_size = Vector2(336, 0)
theme_override_constants/separation = 2

[node name="ColRight" type="VBoxContainer" parent="Center/Card/Margin/VBox/Cols"]
custom_minimum_size = Vector2(336, 0)
theme_override_constants/separation = 2

[node name="CloseRow" type="HBoxContainer" parent="Center/Card/Margin/VBox"]
alignment = 1

[node name="CloseBtn" type="Button" parent="Center/Card/Margin/VBox/CloseRow"]
custom_minimum_size = Vector2(200, 40)
theme_override_font_sizes/font_size = 17
theme_type_variation = &"AccentButton"
text = "知道了"
